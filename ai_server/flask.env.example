# ===========================================
# AI Server (Python Flask Route Planner) Environment Variables
# ===========================================

# Server Host, Port, and Debug Mode
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=true

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000

# Geographic Route Planning Constants
EARTH_RADIUS_KM=6371
ROUTE_MAX_PERPENDICULAR_DIST_KM=10
ROUTE_DEFAULT_SPEED_KMPH=40
