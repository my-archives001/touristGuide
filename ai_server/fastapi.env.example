# ===========================================
# AI Server (Python FastAPI Bot) Environment Variables
# ===========================================

# Server Host and Port
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5001

# MongoDB Atlas Connection URI & DB Name
MONGO_URI=mongodb://username:password@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017,cluster-shard-00-02.mongodb.net:27017/SRP?ssl=true&authSource=admin&retryWrites=true&w=majority
MONGO_DB_NAME=SRP

# OpenRouter API Key & Models
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
SUMMARIZER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
EMBED_SIMILARITY_THRESHOLD=0.65

# Wikipedia API Configuration
WIKIPEDIA_USER_AGENT=ThamizhThadamBot/1.0 (https://github.com/nareshjo001/touristGuide)
WIKIPEDIA_LANGUAGE=en
WIKIPEDIA_TIMEOUT=15

# TTS Configuration
TTS_LANGUAGE=en
TTS_SLOW=false

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000
