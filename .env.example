# ==============================================================================
# Thamizh Thadam — Production Environment Configuration Template (.env.example)
# Copy this file to .env and configure your secure production values.
# ==============================================================================

# --- Node.js Backend Configuration ---
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/touristGuide?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_signing_key_here_minimum_64_characters

# --- Python AI Server Configuration ---
FASTAPI_PORT=5001
FLASK_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OpenRouter / Nemotron AI LLM Configuration ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Thamizh Thadam Heritage Guide
AI_TIMEOUT_SECONDS=30

# --- Frontend API Targets (for build time or dynamic injection) ---
REACT_APP_API_URL=http://localhost:5000
REACT_APP_AI_URL=http://localhost:5001
REACT_APP_ROUTE_URL=http://localhost:8000
