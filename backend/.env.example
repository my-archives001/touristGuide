# ===========================================
# Backend (Node.js/Express) Environment Variables
# ===========================================

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb://username:password@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017,cluster-shard-00-02.mongodb.net:27017/SRP?ssl=true&authSource=admin&retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Security Settings
BCRYPT_SALT_ROUNDS=10

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
